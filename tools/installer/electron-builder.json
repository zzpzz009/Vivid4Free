{
  "appId": "cn.vividai.desktop",
  "productName": "VividDesktop",
  "artifactName": "VividDesktop-Setup-${version}-${arch}.${ext}",
  "electronVersion": "44.9.0",
  "electronDist": "node_modules/electron/dist",
  "directories": {
    "output": "../release/installer"
  },
  "files": [
    "main.cjs",
    "electron-adapter.cjs",
    "account-service.cjs",
    "preload.cjs",
    "server.cjs",
    "task-service.cjs",
    "runtime-manager.cjs",
    "extract-runtime.ps1",
    "runtime-feed.json",
    "client-runtime-policy.json",
    "package.json",
    "assets/app-icon.ico",
    "ui/**/*",
    "workflow-store.cjs",
    "engine-data.dat"
  ],
  "asar": true,
  "asarUnpack": ["extract-runtime.ps1"],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "assets/app-icon.ico",
    "signExecutable": false,
    "forceCodeSigning": false,
    "signtoolOptions": {
      "signingHashAlgorithms": ["sha256"],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    }
  },
  "afterSign": "./desktop/build/verify-signature.cjs",
  "artifactBuildCompleted": "./desktop/build/verify-signature.cjs",
  "extraFiles": [
    { "from": "../LICENSE", "to": "LICENSE" },
    { "from": "../ENGINE-NOTICES.md", "to": "ENGINE-NOTICES.md" }
  ],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "include": "../tools/installer/preserve-runtime.nsh",
    "runAfterFinish": false,
    "installerIcon": "assets/app-icon.ico",
    "uninstallerIcon": "assets/app-icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "publish": null
}
